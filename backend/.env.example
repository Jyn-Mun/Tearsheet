# Copy to `.env` and fill in. NEVER commit `.env`.

# --- Data source -------------------------------------------------------------
# "free"    = live Yahoo via yfinance (no key, but Yahoo rate-limits/blocks some IPs)
# "fmp"     = live Financial Modeling Prep (FREE key below — reliable from any network)  ← live data
# "fixture" = recorded offline sample data (NVDA/SPY/SMH), no network, deterministic
DATA_PROVIDER=fmp

# Free FMP API key — get one (no card) at https://site.financialmodelingprep.com/developer/docs
# then paste it here. Powers real quotes, statements, ratios, earnings, and news.
FMP_API_KEY=

# --- Optional ----------------------------------------------------------------
# Anthropic API for AI synthesis (News + Analysis). If absent, a deterministic grounded mock runs.
ANTHROPIC_API_KEY=

# FRED (St. Louis Fed) free key — 10y Treasury as the DCF risk-free rate. Falls back to 4.3%.
FRED_API_KEY=

# Frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# NOTE: SEC EDGAR is intentionally NOT used in v1 — no SEC_USER_AGENT here.

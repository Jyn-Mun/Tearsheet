# Copy to `.env` and fill in. NEVER commit `.env`.
# v1 needs NO keys to run: data comes from yfinance (Yahoo Finance), which needs no key
# and no personal information. The keys below are optional and only unlock later phases.

# Optional — Anthropic API for AI synthesis (News + Analysis, Phase 4) and the eval LLM-grader.
# If absent, a deterministic mock synthesizer is used so everything still runs.
ANTHROPIC_API_KEY=

# Optional — FRED (St. Louis Fed) free API key for the 10y Treasury risk-free rate in the WACC build.
# If absent, the DCF uses a documented hardcoded fallback risk-free rate.
FRED_API_KEY=

# Comma-separated list of origins allowed to call the API (the frontend dev server).
CORS_ORIGINS=http://localhost:3000

# NOTE: SEC EDGAR is intentionally NOT used in v1, so there is deliberately no SEC_USER_AGENT here.

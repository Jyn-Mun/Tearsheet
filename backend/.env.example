# Copy to `.env` and fill in. NEVER commit `.env`.

# --- Data source -------------------------------------------------------------
# "edgar"   = SEC EDGAR (real 10-K/10-Q fundamentals, no key, unlimited)  ← default
#             Filings-only: no live price/market cap/multiples/news.
# "fmp"     = Financial Modeling Prep (live quotes + statements; free key, ~250/day)
# "free"    = Yahoo via yfinance (no key; rate-limited/blocked on some IPs)
# "fixture" = recorded offline snapshots (always works, no network)
DATA_PROVIDER=edgar

# SEC requires a descriptive User-Agent with a contact (only used for edgar).
SEC_USER_AGENT=Tearsheet/1.0 (your-email@example.com)

# Only needed if DATA_PROVIDER=fmp. Free key: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# --- Optional ----------------------------------------------------------------
# Anthropic API for AI synthesis (News + Analysis). If absent, a deterministic grounded mock runs.
ANTHROPIC_API_KEY=

# FRED (St. Louis Fed) free key — 10y Treasury as the DCF risk-free rate. Falls back to 4.3%.
FRED_API_KEY=

# Frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Copy to `.env` and fill in. NEVER commit `.env`. No paid data sources.

# --- Data source -------------------------------------------------------------
# "hybrid" = SEC EDGAR fundamentals + Yahoo Finance market data  ← default, recommended
# "edgar"  = SEC EDGAR only (fundamentals, no price)
# "free"   = Yahoo / yfinance only
# "fixture"= recorded offline snapshots (always works, no network)
DATA_PROVIDER=hybrid

# SEC requires a descriptive User-Agent with a contact, sent on EVERY sec.gov request.
SEC_USER_AGENT=Tearsheet/1.0 (your-email@example.com)

# --- Optional (all free) -----------------------------------------------------
# Anthropic API for AI synthesis (News + Analysis + Interpretation). If unset, a clean
# "AI narrative disabled" note is shown and all numeric sections still work.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8     # or claude-haiku-4-5 to cut cost

# Free local-LLM fallback: set to an installed Ollama model (e.g. llama3.1) to enable AI
# synthesis with no API key / no cost. Used only when ANTHROPIC_API_KEY is unset.
OLLAMA_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434

# FRED (St. Louis Fed) free key — 10y Treasury (DGS10) as the DCF risk-free rate. Falls back to 4.3%.
FRED_API_KEY=

# Frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

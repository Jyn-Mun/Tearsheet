# Copy to `.env` and fill in. NEVER commit `.env`. No paid data sources. All secrets via env.

# --- Data source -------------------------------------------------------------
# "hybrid" = SEC EDGAR fundamentals + Yahoo Finance market data  ← default, recommended
# "edgar"  = SEC EDGAR only (fundamentals, no price)
# "free"   = Yahoo / yfinance only
# "fixture"= recorded offline snapshots (always works, no network)
DATA_PROVIDER=hybrid

# SEC requires a descriptive User-Agent with a contact, sent on EVERY sec.gov request.
SEC_USER_AGENT=Tearsheet/1.0 (your-email@example.com)

# --- Market-data source (the hybrid's price/history feed) -------------------
# "alpaca"     = keyed API, NOT IP-blocked → use in PRODUCTION (free IEX feed)
# "twelvedata" = keyed API (800/day free)
# "yfinance"   = Yahoo scraping — LOCAL DEV ONLY (blocked from datacenter IPs)
DATA_SOURCE=yfinance

# Alpaca market data (free): keys from https://alpaca.markets — env only, never committed.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Twelve Data (alternative keyed source, 800 calls/day free).
TWELVEDATA_API_KEY=

# --- Resilience (recommended for a public deploy) ----------------------------
# Serve the request path ONLY from cached/pre-fetched data — never call upstream live per visitor.
SERVE_FROM_CACHE_ONLY=false
# In-process pre-fetch scheduler: warm the cache for PREFETCH_TICKERS every N hours.
ENABLE_PREFETCH=false
PREFETCH_INTERVAL_HOURS=6
# Configurable popular-ticker list the pre-fetch job warms (comma-separated). Defaults to ~25.
# PREFETCH_TICKERS=AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA,...

# --- Deployment / security ---------------------------------------------------
# CORS lock for the PUBLIC build: set to your exact Netlify URL (no trailing slash). The API
# then allows ONLY this origin — never "*". Comma-separate if you also use a preview domain.
# Example: https://your-site.netlify.app
FRONTEND_ORIGIN=
# Local dev fallback (used only when FRONTEND_ORIGIN is unset):
CORS_ORIGINS=http://localhost:3000
# Research-only public build: keep trading OFF. (No broker/trading routes exist; this guards
# any you might add later.) Never set true on a public deploy.
ENABLE_TRADING=false

# --- Optional (all free) -----------------------------------------------------
# Anthropic API for AI narrative. If unset, a clean "AI narrative disabled" note is shown and
# every numeric section still works. Read from env only — never hardcode/commit a key.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8     # or claude-haiku-4-5 to cut cost

# Free local-LLM fallback (used only if ANTHROPIC_API_KEY is unset): set to an Ollama model.
OLLAMA_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434

# FRED (St. Louis Fed) free key — 10y Treasury (DGS10) as the DCF risk-free rate. Falls back to 4.3%.
FRED_API_KEY=
